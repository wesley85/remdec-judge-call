# Set these through Render Environment. Never commit actual values.
DATABASE_URL=
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TEST_ADMIN_USERNAME=TestAdmin
TEST_ADMIN_PASSWORD=
# Optional: fixed practice key. If blank, derived securely from SESSION_SECRET.
TEST_STAFF_KEY=
# Set to the actual HTTPS Render URL after the service has been created.
APP_ORIGIN=
NODE_ENV=production
PORT=10000

# Successful sign-in notifications (HTTPS email API; no SMTP).
RESEND_API_KEY=
LOGIN_NOTIFY_FROM=
LOGIN_NOTIFY_TO=
# Verified/configured email belonging to the normal organizer account.
ADMIN_EMAIL=
